{
  "name": "bookshelf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/api.js\" \"vite\"",
    "build": "npm run fetch-covers && vite build",
    "build:quick": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-covers": "node scripts/fetch-covers.js",
